# ---- Browser (public; VITE_ variables are bundled into the site) ----
# Clerk — https://dashboard.clerk.com → your application → API keys
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# Comma-separated emails that get admin access. Read by the API on the server.
# (Alternatively set a user's Clerk public metadata to {"role": "admin"}.)
VITE_ADMIN_EMAILS=admin@example.com

# ---- Server only (never prefix these with VITE_) ----
# Clerk secret key — verifies sign-in on the API.
CLERK_SECRET_KEY=your-clerk-secret-key

# Neon Postgres connection string (Vercel → Storage → your database).
DATABASE_URL=your-neon-connection-string
